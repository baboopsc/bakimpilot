# Copy to .env and change every secret. Never commit .env.
DJANGO_SECRET_KEY=replace-with-50-random-characters
POSTGRES_PASSWORD=replace-me
# Shared secret between the Go ingest service and the API.
INGEST_TOKEN=replace-with-a-long-random-token
# Production only (docker-compose.prod.yml):
DOMAIN=bakimpilot.example.com
# AI: "auto" = Claude when LLM_API_KEY is set, otherwise the offline mock (D-036).
LLM_PROVIDER=auto
LLM_API_KEY=
# Local http://localhost testing over plain HTTP: browsers accept Secure cookies on localhost.
REFRESH_COOKIE_SECURE=true
