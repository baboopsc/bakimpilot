# Caddy terminates TLS (certificates are obtained and renewed automatically).
{$DOMAIN} {
	encode zstd gzip

	# Django admin and its static files go straight to the API.
	handle /admin* {
		reverse_proxy api:8000
	}
	handle /static/* {
		reverse_proxy api:8000
	}

	# Everything else, including /api/*, goes to Next.js (which proxies /api to Django).
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
